APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oge_trainer
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=https://example.invalid
LOG_LEVEL=INFO

# Written-response pilot and optional paid assessment. Defaults keep both off.
OGE_PART2_ENABLED=false
OGE_GRADING_ENABLED=false
OGE_GRADING_MODEL=gpt-6.2-sol
OGE_GRADING_DAILY_USER_LIMIT=4
OGE_GRADING_MONTHLY_BUDGET_USD=0
OGE_GRADING_MAX_IMAGES=4
OGE_GRADING_TIMEOUT_SECONDS=45
# Set verified list prices and the maximum input context for the exact model.
OGE_GRADING_TARIFF_MODEL=
OGE_GRADING_INPUT_USD_PER_MILLION=0
OGE_GRADING_OUTPUT_USD_PER_MILLION=0
OGE_GRADING_CONTEXT_TOKENS=0
