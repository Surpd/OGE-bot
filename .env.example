APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oge_trainer
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=https://example.invalid
LOG_LEVEL=INFO

# Written solutions. Store the OpenAI credential only in the service secret environment.
OGE_PART2_ENABLED=false
OGE_GRADING_ENABLED=false
OGE_GRADING_MODEL=gpt-6.1-terra
OGE_GRADING_DAILY_USER_LIMIT=25
OGE_GRADING_MONTHLY_USER_LIMIT=150
OGE_GRADING_MONTHLY_BUDGET_USD=5
OGE_GRADING_MAX_IMAGES=1
OGE_GRADING_TIMEOUT_SECONDS=45
OGE_GRADING_REQUEST_BUDGET_USD=0.10
OGE_GRADING_CONTEXT_TOKENS=30000

# Optional second Telegram bot inside THIS service. No new service or DATABASE_URL.
# Leave blank to disable. Owner supplies the NEW BotFather token as a secret.
TELEGRAM_TEST_BOT_TOKEN=
# Explicit numeric Telegram owner IDs (comma-separated, 1–5); empty fails closed.
TELEGRAM_TEST_OWNER_IDS=
# Webhook path, random secret, bot ID and isolated DB schema are automatic.
# Keep APP_ENV, TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET and DATABASE_URL unchanged.
# Runbook: reports/companion-test-bot.md

# Queue compact source references during a historical import before exposing the UI.
OGE_ADAPTIVE_CAPTURE_ONLY=false
OGE_COMPANION_ADAPTIVE_CAPTURE_ONLY=false
OGE_ADAPTIVE_ENABLED=true
OGE_COMPANION_ADAPTIVE_ENABLED=false
