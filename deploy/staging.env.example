# Example only. Configure real secrets in the NEW service; never commit an .env.
APP_ENV=staging
STAGING_OWNER_ID=<Dmitry numeric Telegram user ID>
STAGING_BOT_ID=<new bot numeric ID, not a token>
STAGING_PRODUCTION_BOT_ID=<existing production bot numeric ID, not a token>
STAGING_HOSTNAME=<new staging HTTPS hostname, without scheme>
STAGING_PRODUCTION_HOSTNAME=<existing production hostname, without scheme>
STAGING_RELEASE_SHA=<exact 40-character candidate commit>
WEBHOOK_BASE_URL=https://<new staging HTTPS hostname>
TELEGRAM_BOT_TOKEN=<new BotFather token, secret field only>
TELEGRAM_WEBHOOK_SECRET=<new random secret, secret field only>
DATABASE_URL=<new EMPTY dedicated PostgreSQL database, secret field only>
OGE_PART2_ENABLED=true
OGE_GRADING_ENABLED=false
# OPENAI_API_KEY must be ABSENT (not a copied production key).
# STAGING_INIT_EMPTY_DATABASE=yes is only for one manual initialization command.
# Render supplies RENDER_GIT_COMMIT. Docker uses --build-arg SOURCE_COMMIT=<same SHA>.
